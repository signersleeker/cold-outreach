# Copy to .env.test. Used only by pytest (see tests/conftest.py).
# Points at a separate database so the suite can never touch dev data.
DATABASE_URL=postgres://outreach:outreach@localhost:5433/outreach_test?sslmode=disable
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
SECRET_KEY=test-secret-key-not-for-production-use
OUTREACH_APP_PASSWORD=test-password
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
ZEROBOUNCE_API_KEY=
DAILY_CAP=20
