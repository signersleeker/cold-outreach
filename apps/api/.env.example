# Kinnatic Outreach — API configuration.
# Copy to .env and fill in the blanks.  .env is gitignored; keep it that way.

# ---------------------------------------------------------------- app ----
# APP_BASE_URL is what goes into the unsubscribe link inside every email, and
# the Google OAuth redirect URI is derived from it. If you change it, you must
# change the Authorised redirect URI in Google Cloud to match exactly.
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
PORT=8000

# Set true to have FastAPI serve the built React app from apps/web/dist,
# putting the whole thing on one origin. Leave false for two-server dev.
SERVE_FRONTEND=false

# ----------------------------------------------------------- database ----
# Host port 5433 — the docker-compose Postgres. 5432 is the system Postgres.
DATABASE_URL=postgres://outreach:outreach@localhost:5433/outreach?sslmode=disable

# ------------------------------------------------------------ secrets ----
# Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# SECRET_KEY signs the session cookie, derives the AES-GCM key that encrypts
# the Gmail refresh token, and HMACs the OAuth state parameter. Leaking it
# means both session forgery and token decryption. Rotating it logs you out
# and makes the stored Gmail token undecryptable (just reconnect Gmail).
SECRET_KEY=
OUTREACH_APP_PASSWORD=

# Leave false on http://localhost. Set true only behind HTTPS.
SESSION_COOKIE_SECURE=false

# -------------------------------------------------------- Gmail OAuth ----
# Google Cloud > APIs & Services > Credentials > OAuth client ID > Web application.
# Authorised redirect URI must be EXACTLY:
#   http://localhost:8000/auth/google/callback
# See README for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------------- validation ----
# Blank => syntax + MX check via dnspython (free, no third party).
# Set    => ZeroBounce is used instead.
# Neither path ever opens an SMTP connection to a prospect's mail server.
ZEROBOUNCE_API_KEY=

# -------------------------------------------------------- send policy ----
# DAILY_CAP seeds the value in the settings table on first seed; after that the
# Settings page is authoritative. The server clamps it to HARD_MAX_DAILY_CAP=50
# regardless of what is stored.
DAILY_CAP=20
COOLDOWN_DAYS=14

# Informational only. All date arithmetic uses ZoneInfo("Australia/Brisbane")
# explicitly in app/lib/clock.py, so the daily cap does not depend on this.
TZ=Australia/Brisbane
