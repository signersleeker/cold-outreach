{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/app",
  "tags": ["type:app", "scope:api", "language:python"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["db-up"],
      "options": {
        "command": "sh -c 'PATH=\"$PWD/.venv/bin:$PATH\" exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT:-8000}\" --reload'",
        "cwd": "{projectRoot}"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'PATH=\"$PWD/.venv/bin:$PATH\" exec pip install -r requirements.txt'",
        "cwd": "{projectRoot}"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'PATH=\"$PWD/.venv/bin:$PATH\" exec python -m app.cli.seed'",
        "cwd": "{projectRoot}"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'PATH=\"$PWD/.venv/bin:$PATH\" exec python -m app.cli.migrate up'",
        "cwd": "{projectRoot}"
      }
    },
    "migrate-down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'PATH=\"$PWD/.venv/bin:$PATH\" exec python -m app.cli.migrate down'",
        "cwd": "{projectRoot}"
      }
    },
    "migrate-status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'PATH=\"$PWD/.venv/bin:$PATH\" exec python -m app.cli.migrate status'",
        "cwd": "{projectRoot}"
      }
    },
    "reconcile": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'PATH=\"$PWD/.venv/bin:$PATH\" exec python -m app.cli.reconcile_sends'",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'PATH=\"$PWD/.venv/bin:$PATH\" exec pytest'",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh -c 'PATH=\"$PWD/.venv/bin:$PATH\" exec ruff check .'",
        "cwd": "{projectRoot}"
      }
    },
    "db-up": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "docker compose up -d --wait", "cwd": "{projectRoot}" }
    },
    "db-down": {
      "executor": "nx:run-commands",
      "options": { "command": "docker compose down", "cwd": "{projectRoot}" }
    }
  }
}
